# Trading Knights — required environment variables (names only; no values here).
# Copy to .env / .env.local and fill in, or set these in the Vercel dashboard.

# Postgres connection string (Supabase / Neon / Vercel Postgres, etc.).
DATABASE_URL=

# Secret used to sign session cookies. Use a long random string.
SESSION_SECRET=

# OpenAI API key for the MK-AI assistant.
OPENAI_API_KEY=

# Optional: override the OpenAI base URL (e.g. an OpenAI-compatible gateway).
OPENAI_BASE_URL=

# Resend API key for transactional email (verification, etc.).
RESEND_API_KEY=

# From address for outbound email, e.g. "Trading Knights <onboarding@resend.dev>".
EMAIL_FROM=

# Public base URL of the deployed app, used to build links in emails.
APP_BASE_URL=
